rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /drivers/{id}     { allow read, write: if request.auth != null; }
    match /shipments/{id}   { allow read, write: if request.auth != null; }
    match /attachments/{id} { allow read, write: if request.auth != null; }
    match /exporters/{id}   { allow read, write: if request.auth != null; }
    match /users/{id}       { allow read, write: if request.auth != null; }
  }
}
