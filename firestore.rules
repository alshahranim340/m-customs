rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ── Export ──
    match /drivers/{id}     { allow read, write: if request.auth != null; }
    match /shipments/{id}   { allow read, write: if request.auth != null; }
    match /attachments/{id} { allow read, write: if request.auth != null; }
    match /exporters/{id}   { allow read, write: if request.auth != null; }
    match /users/{id}       { allow read, write: if request.auth != null; }
    match /folders/{id}     { allow read, write: if request.auth != null; }
    // ── Quotations ──
    match /quotations/{id}        { allow read, write: if request.auth != null; }
    // ── Import ──
    match /import_customers/{id}  { allow read, write: if request.auth != null; }
    match /import_agents/{id}     { allow read, write: if request.auth != null; }
    match /import_shipments/{id}  { allow read, write: if request.auth != null; }
    match /import_expenses/{id}   { allow read, write: if request.auth != null; }
    match /import_fee_types/{id}  { allow read, write: if request.auth != null; }
  }
}
